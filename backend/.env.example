# MonsoonAI backend environment variables.
#
# Open-Meteo (the default live weather provider) needs NO API key, so this
# file is empty by default - live mode works with zero configuration.
#
# This variable is reserved for a future provider that DOES require a key.
# If you add one, read it in the new provider module with
# os.getenv("LIVE_PROVIDER_API_KEY", "") - never commit a real key, and never
# expose it to the frontend. The frontend only ever talks to this backend,
# never to a weather provider directly.
# LIVE_PROVIDER_API_KEY=

# Where the frontend looks for this backend (set in frontend/.env, not here -
# listed for reference only).
# VITE_API_URL=http://localhost:8000
